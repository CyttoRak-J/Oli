{
  "name": "oli",
  "productName": "Oli",
  "version": "1.0.2",
  "description": "A premium desktop music player and local library manager for Windows.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Cytto",
    "email": "contributors@cyttoplay.example"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/cyttorak-j/Oli",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyttorak-j/Oli.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0 --ignore-pattern out --ignore-pattern dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/icon-gen.mjs",
    "build:win": "npm run typecheck && npm run build && electron-builder --win",
    "build:win:dir": "npm run typecheck && npm run build && electron-builder --win --dir",
    "build:mac": "npm run typecheck && npm run build && electron-builder --mac",
    "build:mac:dir": "npm run typecheck && npm run build && electron-builder --mac --dir",
    "dist": "npm run build:win"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "hls.js": "^1.6.17",
    "lucide-react": "^1.30.0",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.0.0",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@radix-ui/react-checkbox": "^1.2.6",
    "@radix-ui/react-context-menu": "^2.2.18",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
